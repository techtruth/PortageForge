#!/usr/bin/env bash
set -Eeuo pipefail

out_dir=${1:-vm/targets}
PORTAGE_DIR=/etc/portage
WORLD_FILE=/var/lib/portage/world

profile_name() {
  if ! command -v eselect >/dev/null 2>&1; then
    printf '[export-target] error: eselect not found\n' >&2
    exit 1
  fi

  eselect profile show 2>/dev/null | awk '/^  / { print $1; exit }'
}

portage_envvar() {
  local variable_name=$1

  if ! command -v portageq >/dev/null 2>&1; then
    printf '[export-target] error: portageq not found\n' >&2
    exit 1
  fi

  portageq envvar "$variable_name" || true
}

validate_explicit_target_flags() {
  local failed=0
  local path
  local value
  local variable_name

  for variable_name in COMMON_FLAGS CFLAGS CXXFLAGS FCFLAGS FFLAGS; do
    value=$(portage_envvar "$variable_name")
    if [[ "$value" =~ (^|[[:space:]])-m(arch|tune)=native([[:space:]]|$) ]]; then
      printf '[export-target] error: %s contains native CPU flags: %s\n' "$variable_name" "$value" >&2
      failed=1
    fi
  done

  for path in "$PORTAGE_DIR/make.conf" "$PORTAGE_DIR/env"; do
    [[ -e "$path" ]] || continue
    if grep -R -n -E -- '(^|[[:space:]])-m(arch|tune)=native([[:space:]]|$)' "$path" >&2; then
      failed=1
    fi
  done

  if [[ "$failed" -ne 0 ]]; then
    printf '[export-target] error: PortageForge true-cross snapshots require explicit target flags such as -march=znver4\n' >&2
    exit 1
  fi
}

validate_profile_name() {
  local profile=$1

  if [[ -z "$profile" || "$profile" == /* || "$profile" == .. || "$profile" == ../* || "$profile" == */../* || "$profile" == */.. ]]; then
    printf '[export-target] error: active profile path is unsafe: %s\n' "$profile" >&2
    exit 1
  fi
  if [[ ! "$profile" =~ ^[A-Za-z0-9._+/-]+$ ]]; then
    printf '[export-target] error: active profile has unsupported characters: %s\n' "$profile" >&2
    exit 1
  fi
}

safe_name() {
  local name=$1

  name=$(printf '%s' "$name" | tr -c 'A-Za-z0-9._-' '-')
  name=${name##-}
  name=${name%%-}
  printf '%s' "${name:-target}"
}

copy_if_present() {
  local source=$1
  local destination=$2

  if [[ -e "$source" || -L "$source" ]]; then
    mkdir -p "$(dirname "$destination")"
    cp -a "$source" "$destination"
  fi
}

write_package_list() {
  local destination=$1
  local entry

  {
    printf '# PortageForge target package roots\n'
    printf '# Derived from /var/lib/portage/world on the target.\n'
    printf '# PortageForge also builds @system and the dependency closure.\n'
    printf '\n'

    for entry in "${PACKAGE_ENTRIES[@]}"; do
      printf '%s\n' "$entry"
    done
  } >"$destination"
}

load_package_entries() {
  local entries_output

  entries_output=$(awk 'NF && $1 !~ /^#/ { print $1 }' "$WORLD_FILE" | sort -u)
  if [[ -z "$entries_output" ]]; then
    printf '[export-target] error: no target world package entries found in %s\n' "$WORLD_FILE" >&2
    exit 1
  fi

  mapfile -t PACKAGE_ENTRIES <<<"$entries_output"
}

if [[ ! -f "$PORTAGE_DIR/make.conf" ]]; then
  printf '[export-target] error: make.conf not found: %s\n' "$PORTAGE_DIR/make.conf" >&2
  exit 1
fi

if [[ ! -s "$WORLD_FILE" ]]; then
  printf '[export-target] error: target world file not found or empty: %s\n' "$WORLD_FILE" >&2
  exit 1
fi

profile=$(profile_name)
if [[ -z "$profile" ]]; then
  printf '[export-target] error: could not determine active Gentoo profile\n' >&2
  exit 1
fi
validate_profile_name "$profile"
target_chost=$(portage_envvar CHOST)
if [[ -z "$target_chost" ]]; then
  printf '[export-target] error: could not determine target CHOST\n' >&2
  exit 1
fi
if [[ ! "$target_chost" =~ ^[A-Za-z0-9._-]+$ ]]; then
  printf '[export-target] error: invalid target CHOST: %s\n' "$target_chost" >&2
  exit 1
fi
validate_explicit_target_flags

target_hostname=$(hostname -s 2>/dev/null || hostname 2>/dev/null || printf 'target')
target_hostname=$(safe_name "$target_hostname")
mkdir -p "$out_dir"
out_file="${out_dir}/${target_hostname}.tar"
packages_file="${out_dir}/${target_hostname}.packages"
tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT
snapshot_dir="$tmpdir/snapshot"
PACKAGE_ENTRIES=()

mkdir -p "$snapshot_dir/etc" "$snapshot_dir/metadata"
cp -a "$PORTAGE_DIR" "$snapshot_dir/etc/portage"
rm -f "$snapshot_dir/etc/portage/sets/portageforge-binhost-packages"
copy_if_present /etc/locale.gen "$snapshot_dir/etc/locale.gen"
copy_if_present /etc/locale.conf "$snapshot_dir/etc/locale.conf"
load_package_entries

printf '%s\n' "$target_hostname" >"$snapshot_dir/metadata/hostname"
printf '%s\n' "$profile" >"$snapshot_dir/metadata/profile"
printf '%s\n' "$target_chost" >"$snapshot_dir/metadata/chost"
date -u '+%Y-%m-%dT%H:%M:%SZ' >"$snapshot_dir/metadata/exported-at"

write_package_list "$packages_file"
tar -C "$snapshot_dir" -cf "$out_file" .

printf '[export-target] wrote %s\n' "$out_file" >&2
printf '[export-target] wrote %s\n' "$packages_file" >&2
printf '[export-target] captured %s target world package root(s)\n' "${#PACKAGE_ENTRIES[@]}" >&2
