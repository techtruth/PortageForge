#!/usr/bin/env bash
set -Eeuo pipefail

BUILD_INTERVAL_SECONDS=86400
GENTOO_AUTOBUILDS_URL=https://distfiles.gentoo.org/releases/amd64/autobuilds
TARGETS_SHARE_TAG=portageforge-targets
TARGETS_MOUNT=/mnt/portageforge-targets
TARGET_ROOT=/var/lib/portageforge/target
DATA_SHARE_TAG=portageforge-data
DATA_ROOT=/mnt/portageforge-data
TARGET_DATA_ROOT="$DATA_ROOT/targets"
TARGET_CHROOT_ROOT=/var/lib/portageforge/targets
STAGE3_TMPDIR=/var/tmp/portageforge/stage3
PORTAGE_TMPDIR_ROOT=/var/tmp/portageforge/targets
TARGET_PACKAGE_SET=/etc/portage/sets/portageforge-binhost-packages
BOOTSTRAP_PACKAGE_USE=/etc/portage/package.use/99-portageforge-bootstrap
CHROOT_PKGDIR=/portageforge/binpkgs
CHROOT_DISTDIR=/portageforge/distfiles
CHROOT_PORTAGE_TMPDIR=/var/tmp/portageforge
BINHOST_PORT=8080
CPU_COUNT=$(nproc 2>/dev/null || printf '1')
HTTP_PID=
TARGET_NAME=
TARGET_CHROOT_PATH=
TARGET_PACKAGE_LIST=
PKGDIR_PATH=
DISTDIR_PATH=
PORTAGE_TMPDIR_PATH=
if [[ "$CPU_COUNT" -gt 1 ]]; then
  BUILD_JOBS=$((CPU_COUNT - 1))
else
  BUILD_JOBS=1
fi

# Stop the HTTP server when the build service exits.
cleanup() {
  if [[ -n "$TARGET_CHROOT_PATH" ]]; then
    unmount_target_chroot || true
  fi
  if [[ -n "$HTTP_PID" ]]; then
    kill "$HTTP_PID" 2>/dev/null || true
  fi
}

# Print all target snapshot tar files available inside the Gentoo VM.
list_target_archives() {
  if [[ ! -d "$TARGETS_MOUNT" ]]; then
    printf '[portageforge] error: target snapshot directory not found: %s\n' "$TARGETS_MOUNT" >&2
    exit 1
  fi

  find "$TARGETS_MOUNT" -maxdepth 1 -type f -name '*.tar' | sort
}

# Mount the target-input directory shared by QEMU.
prepare_targets_share() {
  mkdir -p "$TARGETS_MOUNT"
  if mountpoint -q "$TARGETS_MOUNT"; then
    return
  fi

  if ! mount -t 9p -o trans=virtio,version=9p2000.L,ro "$TARGETS_SHARE_TAG" "$TARGETS_MOUNT"; then
    printf '[portageforge] error: could not mount targets share tag %s at %s\n' "$TARGETS_SHARE_TAG" "$TARGETS_MOUNT" >&2
    exit 1
  fi
}

# Mount the writable host directory used for durable Portage artifacts.
prepare_data_share() {
  mkdir -p "$DATA_ROOT"
  if ! mountpoint -q "$DATA_ROOT"; then
    if ! mount -t 9p -o trans=virtio,version=9p2000.L "$DATA_SHARE_TAG" "$DATA_ROOT"; then
      printf '[portageforge] error: could not mount data share tag %s at %s\n' "$DATA_SHARE_TAG" "$DATA_ROOT" >&2
      exit 1
    fi
  fi

  mkdir -p "$TARGET_DATA_ROOT" "$TARGET_CHROOT_ROOT" "$STAGE3_TMPDIR" "$PORTAGE_TMPDIR_ROOT"
}

# Keep target names usable as URL path segments and local directory names.
sanitize_target_name() {
  local name=$1

  name=$(printf '%s' "$name" | tr -c 'A-Za-z0-9._-' '-')
  name=${name##-}
  name=${name%%-}
  printf '%s' "${name:-target}"
}

# Fetch one URL to a path using whichever downloader exists in the VM.
fetch_url() {
  local destination=$1
  local url=$2

  if command -v curl >/dev/null 2>&1; then
    curl -fL -o "$destination" "$url"
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$destination" "$url"
  else
    printf '[portageforge] error: curl or wget is required to fetch %s\n' "$url" >&2
    return 1
  fi
}

# Choose the closest Gentoo stage3 flavor for the exported target profile.
stage3_variant_for_profile() {
  local init_style=openrc
  local profile=$1
  local variant=amd64

  if [[ "$profile" == *systemd* ]]; then
    init_style=systemd
  fi
  if [[ "$profile" == *no-multilib* || "$profile" == *nomultilib* ]]; then
    variant=amd64-nomultilib
  fi

  printf '%s-%s\n' "$variant" "$init_style"
}

# Download and verify the current stage3 tarball for a stage3 variant.
download_stage3() {
  local actual_hash
  local archive_path
  local expected_hash
  local latest_file
  local sha_file
  local stage3_dir
  local stage3_name
  local variant=$1
  local variant_dir

  variant_dir=$(mktemp -d "$STAGE3_TMPDIR/$variant.XXXXXX")
  stage3_dir="current-stage3-$variant"
  latest_file="$variant_dir/latest-stage3-$variant.txt"

  if ! fetch_url "$latest_file" "$GENTOO_AUTOBUILDS_URL/$stage3_dir/latest-stage3-$variant.txt" >&2; then
    rm -rf "$variant_dir"
    return 1
  fi
  stage3_name=$(awk '/^[^#].*\.tar\.(xz|zst)[[:space:]]+[0-9]+/ { print $1; exit }' "$latest_file")
  if [[ -z "$stage3_name" ]]; then
    printf '[portageforge] error: could not find stage3 filename in %s\n' "$latest_file" >&2
    rm -rf "$variant_dir"
    return 1
  fi

  archive_path="$variant_dir/$stage3_name"
  sha_file="$archive_path.sha256"
  printf '[portageforge] fetching stage3 %s\n' "$stage3_name" >&2
  if ! fetch_url "$archive_path" "$GENTOO_AUTOBUILDS_URL/$stage3_dir/$stage3_name" >&2; then
    rm -rf "$variant_dir"
    return 1
  fi
  if ! fetch_url "$sha_file" "$GENTOO_AUTOBUILDS_URL/$stage3_dir/$stage3_name.sha256" >&2; then
    rm -rf "$variant_dir"
    return 1
  fi

  expected_hash=$(awk -v file="$stage3_name" '
    $0 ~ file {
      for (i = 1; i <= NF; i++) {
        if ($i ~ /^[0-9a-fA-F]{64}$/) {
          print tolower($i)
          exit
        }
      }
    }
  ' "$sha_file")
  if [[ -z "$expected_hash" ]]; then
    printf '[portageforge] error: could not parse SHA256 from %s\n' "$sha_file" >&2
    rm -rf "$variant_dir"
    return 1
  fi
  actual_hash=$(sha256sum "$archive_path" | awk '{ print $1 }')
  if [[ "$actual_hash" != "$expected_hash" ]]; then
    printf '[portageforge] error: SHA256 mismatch for %s\n' "$stage3_name" >&2
    rm -rf "$variant_dir"
    return 1
  fi

  printf '%s\n' "$archive_path"
}

# Create or reuse the persistent Gentoo root used to build one target.
ensure_target_chroot() {
  local archive_path
  local current_variant=
  local profile=$1
  local variant
  local variant_file="$TARGET_CHROOT_PATH/.portageforge-stage3-variant"
  local stage3_download_dir

  variant=$(stage3_variant_for_profile "$profile")
  if [[ -s "$variant_file" ]]; then
    current_variant=$(<"$variant_file")
  fi
  if [[ -x "$TARGET_CHROOT_PATH/bin/bash" && -x "$TARGET_CHROOT_PATH/usr/bin/emerge" && "$current_variant" == "$variant" ]]; then
    return
  fi

  archive_path=$(download_stage3 "$variant")
  stage3_download_dir=$(dirname "$archive_path")
  printf '[portageforge] creating %s chroot for %s\n' "$variant" "$TARGET_NAME"
  unmount_target_chroot || true
  rm -rf "$TARGET_CHROOT_PATH"
  mkdir -p "$TARGET_CHROOT_PATH"
  if ! tar -xpf "$archive_path" -C "$TARGET_CHROOT_PATH" --xattrs --numeric-owner; then
    rm -rf "$stage3_download_dir"
    return 1
  fi
  printf '%s\n' "$variant" >"$variant_file"
  rm -rf "$stage3_download_dir"
}

# Bind one host path into the current target chroot when it is not mounted yet.
bind_mount_if_needed() {
  local source=$1
  local destination=$2

  mkdir -p "$source" "$destination"
  if ! mountpoint -q "$destination"; then
    mount --bind "$source" "$destination"
  fi
}

# Mount runtime filesystems and Portage artifact paths for the target chroot.
mount_target_chroot() {
  mkdir -p \
    "$TARGET_CHROOT_PATH/proc" \
    "$TARGET_CHROOT_PATH/sys" \
    "$TARGET_CHROOT_PATH/dev" \
    "$TARGET_CHROOT_PATH/run" \
    "$TARGET_CHROOT_PATH/portageforge/binpkgs" \
    "$TARGET_CHROOT_PATH/portageforge/distfiles" \
    "$TARGET_CHROOT_PATH$CHROOT_PORTAGE_TMPDIR"

  if ! mountpoint -q "$TARGET_CHROOT_PATH/proc"; then
    mount -t proc proc "$TARGET_CHROOT_PATH/proc"
  fi
  if ! mountpoint -q "$TARGET_CHROOT_PATH/sys"; then
    mount --rbind /sys "$TARGET_CHROOT_PATH/sys"
    mount --make-rslave "$TARGET_CHROOT_PATH/sys" 2>/dev/null || true
  fi
  if ! mountpoint -q "$TARGET_CHROOT_PATH/dev"; then
    mount --rbind /dev "$TARGET_CHROOT_PATH/dev"
    mount --make-rslave "$TARGET_CHROOT_PATH/dev" 2>/dev/null || true
  fi
  if ! mountpoint -q "$TARGET_CHROOT_PATH/run"; then
    mount --rbind /run "$TARGET_CHROOT_PATH/run"
    mount --make-rslave "$TARGET_CHROOT_PATH/run" 2>/dev/null || true
  fi

  bind_mount_if_needed "$PKGDIR_PATH" "$TARGET_CHROOT_PATH$CHROOT_PKGDIR"
  bind_mount_if_needed "$DISTDIR_PATH" "$TARGET_CHROOT_PATH$CHROOT_DISTDIR"
  bind_mount_if_needed "$PORTAGE_TMPDIR_PATH" "$TARGET_CHROOT_PATH$CHROOT_PORTAGE_TMPDIR"
}

# Unmount runtime filesystems and Portage artifact paths for the target chroot.
unmount_target_chroot() {
  local mount_path

  for mount_path in \
    "$TARGET_CHROOT_PATH$CHROOT_PORTAGE_TMPDIR" \
    "$TARGET_CHROOT_PATH$CHROOT_DISTDIR" \
    "$TARGET_CHROOT_PATH$CHROOT_PKGDIR" \
    "$TARGET_CHROOT_PATH/run" \
    "$TARGET_CHROOT_PATH/dev" \
    "$TARGET_CHROOT_PATH/sys" \
    "$TARGET_CHROOT_PATH/proc"; do
    if [[ -n "$TARGET_CHROOT_PATH" && -e "$mount_path" ]] && mountpoint -q "$mount_path"; then
      umount -R "$mount_path"
    fi
  done
}

# Run a command inside the current target chroot.
chroot_run() {
  chroot "$TARGET_CHROOT_PATH" "$@"
}

# Run emerge inside the current target chroot.
chroot_emerge() {
  chroot_run emerge "$@"
}

# Print the Portage settings that make the chroot emit PortageForge binpkgs.
builder_make_conf_settings() {
  printf '\n# BEGIN portageforge-builder\n'
  printf 'FEATURES="${FEATURES} buildpkg binpkg-multi-instance"\n'
  printf 'PKGDIR="%s"\n' "$CHROOT_PKGDIR"
  printf 'DISTDIR="%s"\n' "$CHROOT_DISTDIR"
  printf 'PORTAGE_TMPDIR="%s"\n' "$CHROOT_PORTAGE_TMPDIR"
  printf 'BINPKG_FORMAT="gpkg"\n'
  printf 'MAKEOPTS="-j%s"\n' "$BUILD_JOBS"
  printf '# END portageforge-builder\n'
}

# Write target make.conf plus PortageForge artifact settings.
write_target_make_conf() {
  {
    cat "$TARGET_ROOT/etc/portage/make.conf"
    builder_make_conf_settings
  } >"$TARGET_CHROOT_PATH/etc/portage/make.conf"
}

# Write target make.conf without target USE= overrides for the first bootstrap.
write_default_use_make_conf() {
  {
    awk '
      /^[[:space:]]*(export[[:space:]]+)?USE[[:space:]]*=/ { next }
      { print }
    ' "$TARGET_ROOT/etc/portage/make.conf"
    builder_make_conf_settings
  } >"$TARGET_CHROOT_PATH/etc/portage/make.conf"
}

# Copy the exported target Portage tree into the chroot and refresh the set.
copy_target_portage_snapshot() {
  rm -rf "$TARGET_CHROOT_PATH/etc/portage"
  mkdir -p "$TARGET_CHROOT_PATH/etc"
  cp -a "$TARGET_ROOT/etc/portage" "$TARGET_CHROOT_PATH/etc/portage"
  mkdir -p "$TARGET_CHROOT_PATH/etc/portage/sets"
  load_target_package_set "$TARGET_PACKAGE_LIST"
  if [[ ! -s "$TARGET_CHROOT_PATH$TARGET_PACKAGE_SET" ]]; then
    printf '[portageforge] error: target package list has no package entries: %s\n' "$TARGET_PACKAGE_LIST" >&2
    exit 1
  fi
}

# Restore the target's real Portage policy into the chroot.
apply_target_portage_config() {
  printf '[portageforge] applying target /etc/portage snapshot to chroot\n'
  copy_target_portage_snapshot
  write_target_make_conf
}

# Apply target policy with target USE overrides disabled for stable bootstrapping.
apply_default_use_bootstrap_config() {
  printf '[portageforge] applying default-USE bootstrap Portage config\n'
  copy_target_portage_snapshot
  rm -rf \
    "$TARGET_CHROOT_PATH/etc/portage/package.use" \
    "$TARGET_CHROOT_PATH/etc/portage/package.env"
  write_default_use_make_conf
}

# Refresh the chroot environment after changing profile or Portage config.
refresh_chroot_environment() {
  if [[ -x "$TARGET_CHROOT_PATH/usr/sbin/env-update" ]]; then
    chroot_run env-update
  fi
}

# Turn the target snapshot tar into the persistent chroot state used by Portage.
prepare_builder_from_snapshot() {
  local archive=$1
  local archive_name
  local hostname=
  local profile

  rm -rf "$TARGET_ROOT"
  mkdir -p "$TARGET_ROOT"

  printf '[portageforge] loading target snapshot %s\n' "$archive"
  tar -C "$TARGET_ROOT" -xf "$archive"

  if [[ -s "$TARGET_ROOT/metadata/hostname" ]]; then
    hostname=$(awk 'NF { print; exit }' "$TARGET_ROOT/metadata/hostname")
    if [[ -n "$hostname" ]]; then
      printf '[portageforge] target hostname: %s\n' "$hostname"
    fi
  fi
  archive_name=$(basename "$archive" .tar)
  if [[ -z "$hostname" ]]; then
    hostname=$archive_name
  fi
  TARGET_NAME=$(sanitize_target_name "$hostname")
  TARGET_PACKAGE_LIST="$TARGETS_MOUNT/${archive_name}.packages"
  PKGDIR_PATH="$TARGET_DATA_ROOT/$TARGET_NAME/binpkgs"
  DISTDIR_PATH="$TARGET_DATA_ROOT/$TARGET_NAME/distfiles"
  TARGET_CHROOT_PATH="$TARGET_CHROOT_ROOT/$TARGET_NAME/root"
  PORTAGE_TMPDIR_PATH="$PORTAGE_TMPDIR_ROOT/$TARGET_NAME"
  mkdir -p "$PKGDIR_PATH" "$DISTDIR_PATH" "$PORTAGE_TMPDIR_PATH" "$(dirname "$TARGET_CHROOT_PATH")"

  if [[ -d "$TARGET_PACKAGE_LIST" ]]; then
    printf '[portageforge] error: target package path must be a repo-qualified package file, not a directory: %s\n' "$TARGET_PACKAGE_LIST" >&2
    printf '[portageforge] error: re-run make export-target-state on the target to create a single %s file\n' "$TARGET_PACKAGE_LIST" >&2
    exit 1
  fi
  if [[ ! -s "$TARGET_PACKAGE_LIST" ]]; then
    printf '[portageforge] error: target package list not found or empty: %s\n' "$TARGET_PACKAGE_LIST" >&2
    exit 1
  fi

  if [[ ! -s "$TARGET_ROOT/metadata/profile" ]]; then
    printf '[portageforge] error: target snapshot is missing metadata/profile\n' >&2
    exit 1
  fi
  profile=$(awk 'NF { print; exit }' "$TARGET_ROOT/metadata/profile")
  if [[ -z "$profile" ]]; then
    printf '[portageforge] error: target snapshot metadata/profile is empty\n' >&2
    exit 1
  fi

  if [[ ! -d "$TARGET_ROOT/etc/portage" ]]; then
    printf '[portageforge] error: target snapshot is missing etc/portage\n' >&2
    exit 1
  fi
  if [[ ! -s "$TARGET_ROOT/etc/portage/make.conf" ]]; then
    printf '[portageforge] error: target snapshot is missing etc/portage/make.conf\n' >&2
    exit 1
  fi

  ensure_target_chroot "$profile"
  apply_target_portage_config

  printf '[portageforge] target binhost path: /targets/%s/binpkgs/\n' "$TARGET_NAME"
  printf '[portageforge] using %s build job(s)\n' "$BUILD_JOBS"
  printf '[portageforge] loaded %s binhost package entries\n' "$(wc -l <"$TARGET_CHROOT_PATH$TARGET_PACKAGE_SET")"
}

# Copy the repo-qualified target package list into the Portage set used by emerge.
load_target_package_set() {
  local package_list=$1

  awk 'NF && $1 !~ /^#/ { print $1 }' "$package_list" | sort -u >"$TARGET_CHROOT_PATH$TARGET_PACKAGE_SET"
}

# Strip repository constraints so installed package names can be compared.
target_package_names() {
  sed 's/::[A-Za-z0-9._-]\+$//' "$TARGET_CHROOT_PATH$TARGET_PACKAGE_SET" | sort -u
}

# List package names currently installed in the target chroot.
installed_chroot_package_names() {
  local category
  local pkgdir
  local pn
  local pnvr

  for pkgdir in "$TARGET_CHROOT_PATH/var/db/pkg"/*/*; do
    [[ -d "$pkgdir" ]] || continue
    category=${pkgdir%/*}
    category=${category##*/}
    pnvr=${pkgdir##*/}
    pn=${pnvr%-[0-9]*}
    printf '%s/%s\n' "$category" "$pn"
  done | sort -u
}

# Make an /etc/portage config path a directory while preserving target content.
ensure_portage_config_directory() {
  local config_name=$1
  local config_path="$TARGET_CHROOT_PATH/etc/portage/$config_name"
  local target_file

  if [[ -d "$config_path" ]]; then
    return
  fi
  if [[ -e "$config_path" || -L "$config_path" ]]; then
    target_file="$TARGET_CHROOT_PATH/etc/portage/$config_name.target"
    rm -rf "$target_file"
    mv "$config_path" "$target_file"
    mkdir -p "$config_path"
    mv "$target_file" "$config_path/00-target"
  else
    mkdir -p "$config_path"
  fi
}

# Remove temporary bootstrap USE changes before building final binpkgs.
clear_bootstrap_use_suggestions() {
  local use_file="$TARGET_CHROOT_PATH$BOOTSTRAP_PACKAGE_USE"

  if [[ -d "$(dirname "$use_file")" ]]; then
    rm -f "$use_file"
  fi
}

# Print package.use lines from Portage circular-dependency "Change USE" hints.
bootstrap_use_suggestions() {
  local output_file=$1

  awk '
    /^- [^[:space:]]+ \(Change USE: / {
      atom = $2
      flags = $0
      sub(/^.*\(Change USE: /, "", flags)
      sub(/\).*$/, "", flags)
      if (atom ~ /^[A-Za-z0-9+_.-]+\/[A-Za-z0-9+_.-]+-[0-9]/ && flags ~ /^[-+A-Za-z0-9_@[:space:]]+$/) {
        print "=" atom " " flags
      }
    }
  ' "$output_file" | sort -u
}

# Apply new temporary package.use suggestions from one emerge failure.
apply_bootstrap_use_suggestions() {
  local merged_file="$PORTAGE_TMPDIR_PATH/bootstrap-use-merged"
  local output_file=$1
  local suggestions_file="$PORTAGE_TMPDIR_PATH/bootstrap-use-suggestions"
  local use_file="$TARGET_CHROOT_PATH$BOOTSTRAP_PACKAGE_USE"

  bootstrap_use_suggestions "$output_file" >"$suggestions_file"
  if [[ ! -s "$suggestions_file" ]]; then
    return 1
  fi

  ensure_portage_config_directory package.use
  touch "$use_file"
  cat "$use_file" "$suggestions_file" | sort -u >"$merged_file"
  if cmp -s "$merged_file" "$use_file"; then
    return 1
  fi
  cp "$merged_file" "$use_file"
  printf '[portageforge] applying temporary bootstrap USE change(s)\n'
  sed 's/^/[portageforge] bootstrap USE: /' "$suggestions_file"
}

# Install build-time dependencies once under the current Portage config.
emerge_private_build_dependencies() {
  local update_mode=$1
  shift
  local emerge_args=(
    --usepkg=n
    --getbinpkg=n
    --oneshot
    --ignore-world=y
    --onlydeps
    --onlydeps-with-rdeps=n
    --with-bdeps=y
    --buildpkg=n
    --jobs="$BUILD_JOBS"
  )
  local targets=("$@")

  if [[ "$update_mode" == update ]]; then
    emerge_args+=(--update --deep --newuse)
  fi

  chroot_emerge "${emerge_args[@]}" "${targets[@]}"
}

# Resolve private build-time dependencies with circular-dependency retries.
resolve_private_build_dependencies() {
  local attempt
  local max_attempts=5
  local output_file
  local phase=$1
  local update_mode=$2
  local phase_slug
  shift 2
  local targets=("$@")
  phase_slug=$(printf '%s' "$phase" | tr -c 'A-Za-z0-9._-' '-')
  output_file="$PORTAGE_TMPDIR_PATH/private-build-dependencies-$phase_slug.log"

  for ((attempt = 1; attempt <= max_attempts; attempt++)); do
    printf '[portageforge] resolving private chroot build-time dependencies (%s)\n' "$phase"
    if emerge_private_build_dependencies "$update_mode" "${targets[@]}" 2>&1 | tee "$output_file"; then
      break
    fi
    if [[ "$attempt" -lt "$max_attempts" ]] && apply_bootstrap_use_suggestions "$output_file"; then
      printf '[portageforge] retrying private dependency resolution with temporary bootstrap USE changes\n'
    else
      printf '[portageforge] error: private chroot build-time dependency resolution failed during %s\n' "$phase" >&2
      return 1
    fi
  done
}

# Install build-time dependencies that are private to the target chroot.
install_private_build_dependencies() {
  local private_installed_packages=$1
  shift
  local targets=("$@")
  local target_package_names_file="$PORTAGE_TMPDIR_PATH/target-package-names"

  mkdir -p "$PORTAGE_TMPDIR_PATH"

  clear_bootstrap_use_suggestions
  apply_default_use_bootstrap_config
  refresh_chroot_environment
  if ! resolve_private_build_dependencies default-use-bootstrap missing "${targets[@]}"; then
    return 1
  fi

  clear_bootstrap_use_suggestions
  apply_target_portage_config
  refresh_chroot_environment
  if ! resolve_private_build_dependencies target-use-bootstrap update "${targets[@]}"; then
    return 1
  fi

  clear_bootstrap_use_suggestions
  apply_target_portage_config
  refresh_chroot_environment

  target_package_names >"$target_package_names_file"
  installed_chroot_package_names | comm -23 - "$target_package_names_file" >"$private_installed_packages"
  if [[ -s "$private_installed_packages" ]]; then
    printf '[portageforge] excluding %s private chroot package(s) from binpkg output\n' "$(wc -l <"$private_installed_packages")"
  fi
}

# Copy one optional target snapshot path into the target chroot.
restore_snapshot_path() {
  local relative_path=$1
  local source="$TARGET_ROOT/$relative_path"
  local destination="$TARGET_CHROOT_PATH/$relative_path"

  if [[ -e "$source" || -L "$source" ]]; then
    mkdir -p "$(dirname "$destination")"
    rm -rf "$destination"
    cp -a "$source" "$destination"
  fi
}

# Restore generic target selection state that affects which installed tools run.
restore_target_environment_state() {
  local snapshot_path

  for snapshot_path in \
    etc/env.d \
    etc/eselect \
    etc/python-exec \
    etc/java-config-2 \
    etc/locale.conf \
    etc/locale.gen \
    usr/src/linux; do
    restore_snapshot_path "$snapshot_path"
  done

  if [[ -e /etc/resolv.conf ]]; then
    cp -L /etc/resolv.conf "$TARGET_CHROOT_PATH/etc/resolv.conf"
  fi

  if [[ -e "$TARGET_CHROOT_PATH/etc/locale.gen" ]] && [[ -x "$TARGET_CHROOT_PATH/usr/sbin/locale-gen" ]]; then
    chroot_run locale-gen
  fi
  if [[ -x "$TARGET_CHROOT_PATH/usr/sbin/env-update" ]]; then
    refresh_chroot_environment
  fi
}

# Return success when the target profile exists in the chroot's synced tree.
target_profile_exists() {
  local profile=$1

  [[ -d "$TARGET_CHROOT_PATH/var/db/repos/gentoo/profiles/$profile" ]]
}

# Select the target profile and refresh the chroot environment.
set_target_profile() {
  local profile=$1

  printf '[portageforge] setting Gentoo profile to %s\n' "$profile"
  chroot_run eselect profile set "$profile"
  refresh_chroot_environment
}

# Build current source packages from the target package set.
emerge_target_packages() {
  local emerge_args=(
    --usepkg=n
    --getbinpkg=n
    --oneshot
    --ignore-world=y
    --with-bdeps=y
    --buildpkgonly
    --jobs="$BUILD_JOBS"
  )
  local buildpkg_exclude
  local private_buildpkg_excludes_file="$PORTAGE_TMPDIR_PATH/private-buildpkg-excludes"
  local targets=(@portageforge-binhost-packages)

  if ! install_private_build_dependencies "$private_buildpkg_excludes_file" "${targets[@]}"; then
    clear_bootstrap_use_suggestions
    return 1
  fi
  clear_bootstrap_use_suggestions
  if [[ -s "$private_buildpkg_excludes_file" ]]; then
    buildpkg_exclude=$(paste -sd ' ' "$private_buildpkg_excludes_file")
    emerge_args+=("--buildpkg-exclude=$buildpkg_exclude")
  fi

  if [[ -n "$(find "$PKGDIR_PATH" -type f ! -name Packages -print -quit 2>/dev/null)" ]]; then
    printf '[portageforge] building current binhost package updates\n'
    emerge_args+=(--update --deep --newuse)
  else
    printf '[portageforge] binpkg cache is empty; building full binhost package set\n'
    emerge_args+=(--emptytree)
  fi

  chroot_emerge "${emerge_args[@]}" "${targets[@]}"
}

# Serve the data directory over HTTP so each target gets its own binhost URL.
start_binhost_server() {
  if [[ -n "$HTTP_PID" ]] && kill -0 "$HTTP_PID" 2>/dev/null; then
    return
  fi

  if ! command -v python3 >/dev/null 2>&1; then
    printf '[portageforge] error: python3 is required to serve the binhost\n' >&2
    exit 1
  fi

  mkdir -p "$TARGET_DATA_ROOT"
  python3 -m http.server "$BINHOST_PORT" --bind 0.0.0.0 --directory "$DATA_ROOT" &
  HTTP_PID=$!
  trap cleanup EXIT
  trap 'cleanup; exit 0' INT TERM
  sleep 1
  if ! kill -0 "$HTTP_PID" 2>/dev/null; then
    printf '[portageforge] error: binhost HTTP server failed to start\n' >&2
    exit 1
  fi
  printf '[portageforge] serving binhosts at http://0.0.0.0:%s/targets/<target>/binpkgs/\n' "$BINHOST_PORT"
}

# Build one target snapshot and refresh that target's binhost index.
build_target() {
  local archive=$1
  local profile
  local result=0

  prepare_builder_from_snapshot "$archive"
  profile=$(awk 'NF { print; exit }' "$TARGET_ROOT/metadata/profile")
  mount_target_chroot
  restore_target_environment_state

  if target_profile_exists "$profile"; then
    if ! set_target_profile "$profile"; then
      printf '[portageforge] error: profile selection failed for %s\n' "$TARGET_NAME" >&2
      result=1
    fi
  else
    printf '[portageforge] target profile will be selected after repository sync: %s\n' "$profile"
  fi

  if [[ "$result" -eq 0 ]]; then
    printf '[portageforge] syncing target repositories for %s\n' "$TARGET_NAME"
  fi
  if [[ "$result" -eq 0 ]] && ! chroot_emerge --sync; then
    printf '[portageforge] error: repository sync failed for %s\n' "$TARGET_NAME" >&2
    result=1
  fi

  if [[ "$result" -eq 0 ]]; then
    if ! set_target_profile "$profile"; then
      printf '[portageforge] error: profile selection failed for %s\n' "$TARGET_NAME" >&2
      result=1
    fi
  fi

  if [[ "$result" -eq 0 ]] && ! emerge_target_packages; then
    printf '[portageforge] error: target build failed for %s\n' "$TARGET_NAME" >&2
    result=1
  fi

  if [[ "$result" -eq 0 ]]; then
    printf '[portageforge] refreshing binhost package index\n'
    if ! chroot_run emaint binhost --fix; then
      printf '[portageforge] error: binhost index refresh failed for %s\n' "$TARGET_NAME" >&2
      result=1
    fi
  fi

  if ! unmount_target_chroot; then
    printf '[portageforge] error: could not unmount target chroot for %s\n' "$TARGET_NAME" >&2
    result=1
  fi
  return "$result"
}

# Run one daily sync, then build every target snapshot in sorted order.
build_cycle() {
  local archive
  local archives=()

  mapfile -t archives < <(list_target_archives)
  if [[ "${#archives[@]}" -eq 0 ]]; then
    printf '[portageforge] error: no target snapshot tar found in %s\n' "$TARGETS_MOUNT" >&2
    exit 1
  fi
  printf '[portageforge] found %s target snapshot(s)\n' "${#archives[@]}"

  for archive in "${archives[@]}"; do
    printf '[portageforge] starting target snapshot %s\n' "$archive"
    build_target "$archive"
  done
}

prepare_targets_share
prepare_data_share
start_binhost_server
while true; do
  build_cycle
  printf '[portageforge] build cycle completed successfully\n'
  printf '[portageforge] sleeping %ss before next sync/build\n' "$BUILD_INTERVAL_SECONDS"
  sleep "$BUILD_INTERVAL_SECONDS"
done
