#!/usr/bin/env bash
set -Eeuo pipefail

BUILD_INTERVAL_SECONDS=${PORTAGEFORGE_BUILD_INTERVAL_SECONDS:-86400}
GENTOO_AUTOBUILDS_URL=${PORTAGEFORGE_GENTOO_AUTOBUILDS_URL:-https://distfiles.gentoo.org/releases/amd64/autobuilds}
SYNC_ATTEMPTS=${PORTAGEFORGE_SYNC_ATTEMPTS:-3}
SYNC_RETRY_SECONDS=${PORTAGEFORGE_SYNC_RETRY_SECONDS:-60}
TARGETS_SHARE_TAG=portageforge-targets
TARGETS_MOUNT=/mnt/portageforge-targets
TARGET_ROOT=/var/lib/portageforge/target-snapshot
DATA_SHARE_TAG=portageforge-data
DATA_ROOT=/mnt/portageforge-data
TARGET_DATA_ROOT="$DATA_ROOT/targets"
TARGET_STATE_ROOT=/var/lib/portageforge/targets
BROOT_STATE_ROOT=/var/lib/portageforge/broots
STAGE3_TMPDIR=/var/tmp/portageforge/stage3
PORTAGE_TMPDIR_ROOT=/var/tmp/portageforge/targets
TARGET_PACKAGE_SET=/etc/portage/sets/portageforge-binhost-packages
BINHOST_PORT=${PORTAGEFORGE_BINHOST_PORT:-8080}
BUILDER_CHOST=${PORTAGEFORGE_BUILDER_CHOST:-x86_64-portageforge-linux-gnu}
BUILDER_COMMON_FLAGS=${PORTAGEFORGE_BUILDER_COMMON_FLAGS:-"-O2 -pipe -march=x86-64"}
BUILD_WRAPPERS_DIR=/usr/local/bin
BROOT_PORTAGE_TMPDIR=/var/tmp/portageforge/broot
CPU_COUNT=$(nproc 2>/dev/null || printf '1')
HTTP_PID=
TARGET_NAME=
TARGET_CHOST=
TARGET_PACKAGE_LIST=
TARGET_SYSROOT_PATH=
BROOT_PATH=
TARGET_WRAPPERS_DIR=
PKGDIR_PATH=
DISTDIR_PATH=
PORTAGE_TMPDIR_PATH=
BROOT_MOUNT_POINTS=()
if [[ "$CPU_COUNT" -gt 1 ]]; then
  DEFAULT_BUILD_JOBS=$((CPU_COUNT - 1))
else
  DEFAULT_BUILD_JOBS=1
fi
BUILD_JOBS=${PORTAGEFORGE_BUILD_JOBS:-$DEFAULT_BUILD_JOBS}
CROSS_RESOLVER_ARGS=(
  --backtrack=100
  --autounmask=n
  --verbose-conflicts
)

cleanup() {
  unmount_broot_filesystems || true
  if [[ -n "$HTTP_PID" ]]; then
    kill "$HTTP_PID" 2>/dev/null || true
  fi
}

is_positive_integer() {
  [[ "$1" =~ ^[1-9][0-9]*$ ]]
}

is_tcp_port() {
  is_positive_integer "$1" && [[ "$1" -le 65535 ]]
}

is_safe_tuple() {
  [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]]
}

triplet_cpu() {
  local tuple=$1

  printf '%s\n' "${tuple%%-*}"
}

triplet_abi_suffix() {
  local rest
  local tuple=$1

  rest=${tuple#*-}
  if [[ "$rest" == "$tuple" ]]; then
    printf '\n'
    return
  fi
  rest=${rest#*-}
  if [[ "$rest" == "${tuple#*-}" ]]; then
    printf '\n'
    return
  fi
  printf '%s\n' "$rest"
}

load_builder_config() {
  local config_file="$DATA_ROOT/portageforge-builder.env"

  if [[ -f "$config_file" ]]; then
    printf '[portageforge] loading builder config %s\n' "$config_file"
    # shellcheck disable=SC1090
    . "$config_file"
  fi

  BUILD_INTERVAL_SECONDS=${PORTAGEFORGE_BUILD_INTERVAL_SECONDS:-$BUILD_INTERVAL_SECONDS}
  SYNC_ATTEMPTS=${PORTAGEFORGE_SYNC_ATTEMPTS:-$SYNC_ATTEMPTS}
  SYNC_RETRY_SECONDS=${PORTAGEFORGE_SYNC_RETRY_SECONDS:-$SYNC_RETRY_SECONDS}
  BINHOST_PORT=${PORTAGEFORGE_BINHOST_PORT:-$BINHOST_PORT}
  BUILDER_CHOST=${PORTAGEFORGE_BUILDER_CHOST:-$BUILDER_CHOST}
  BUILDER_COMMON_FLAGS=${PORTAGEFORGE_BUILDER_COMMON_FLAGS:-$BUILDER_COMMON_FLAGS}
  BUILD_JOBS=${PORTAGEFORGE_BUILD_JOBS:-$BUILD_JOBS}
}

validate_builder_config() {
  if ! is_positive_integer "$BUILD_INTERVAL_SECONDS"; then
    printf '[portageforge] error: PORTAGEFORGE_BUILD_INTERVAL_SECONDS must be a positive integer: %s\n' "$BUILD_INTERVAL_SECONDS" >&2
    exit 1
  fi
  if ! is_positive_integer "$SYNC_ATTEMPTS"; then
    printf '[portageforge] error: PORTAGEFORGE_SYNC_ATTEMPTS must be a positive integer: %s\n' "$SYNC_ATTEMPTS" >&2
    exit 1
  fi
  if ! [[ "$SYNC_RETRY_SECONDS" =~ ^[0-9]+$ ]]; then
    printf '[portageforge] error: PORTAGEFORGE_SYNC_RETRY_SECONDS must be a non-negative integer: %s\n' "$SYNC_RETRY_SECONDS" >&2
    exit 1
  fi
  if ! is_tcp_port "$BINHOST_PORT"; then
    printf '[portageforge] error: PORTAGEFORGE_BINHOST_PORT must be a TCP port from 1 through 65535: %s\n' "$BINHOST_PORT" >&2
    exit 1
  fi
  if ! is_positive_integer "$BUILD_JOBS"; then
    printf '[portageforge] error: PORTAGEFORGE_BUILD_JOBS must be a positive integer: %s\n' "$BUILD_JOBS" >&2
    exit 1
  fi
  if ! is_safe_tuple "$BUILDER_CHOST"; then
    printf '[portageforge] error: PORTAGEFORGE_BUILDER_CHOST contains unsupported characters: %s\n' "$BUILDER_CHOST" >&2
    exit 1
  fi
}

list_target_archives() {
  if [[ ! -d "$TARGETS_MOUNT" ]]; then
    printf '[portageforge] error: target snapshot directory not found: %s\n' "$TARGETS_MOUNT" >&2
    exit 1
  fi

  find "$TARGETS_MOUNT" -maxdepth 1 -type f -name '*.tar' | sort
}

prepare_targets_share() {
  mkdir -p "$TARGETS_MOUNT"
  if mountpoint -q "$TARGETS_MOUNT"; then
    return
  fi

  if ! mount -t 9p -o trans=virtio,version=9p2000.L,ro "$TARGETS_SHARE_TAG" "$TARGETS_MOUNT"; then
    printf '[portageforge] error: could not mount targets share tag %s at %s\n' "$TARGETS_SHARE_TAG" "$TARGETS_MOUNT" >&2
    exit 1
  fi
}

prepare_data_share() {
  mkdir -p "$DATA_ROOT"
  if ! mountpoint -q "$DATA_ROOT"; then
    if ! mount -t 9p -o trans=virtio,version=9p2000.L "$DATA_SHARE_TAG" "$DATA_ROOT"; then
      printf '[portageforge] error: could not mount data share tag %s at %s\n' "$DATA_SHARE_TAG" "$DATA_ROOT" >&2
      exit 1
    fi
  fi

  mkdir -p "$TARGET_DATA_ROOT" "$TARGET_STATE_ROOT" "$BROOT_STATE_ROOT" "$STAGE3_TMPDIR" "$PORTAGE_TMPDIR_ROOT"
}

prepare_portage_traversable_dir() {
  local path=$1

  mkdir -p "$path"
  if ! chmod a+rx "$path"; then
    printf '[portageforge] error: could not make %s traversable\n' "$path" >&2
    exit 1
  fi
}

prepare_portage_writable_dir() {
  local group
  local path=$1
  local test_path
  local test_path_q

  mkdir -p "$path"
  if id -u portage >/dev/null 2>&1; then
    group=$(id -gn portage 2>/dev/null || printf 'portage')
    if ! chown "portage:$group" "$path"; then
      printf '[portageforge] error: could not chown %s to portage:%s\n' "$path" "$group" >&2
      exit 1
    fi
  fi
  if ! chmod 2775 "$path"; then
    printf '[portageforge] error: could not chmod 2775 %s\n' "$path" >&2
    exit 1
  fi

  if ! find "$path" -maxdepth 1 \( -name '.__portage_test_write__' -o -name '.__portageforge_write_test__' -o -name '*.__download__' \) -exec rm -f -- {} +; then
    printf '[portageforge] error: could not remove stale Portage temporary files from %s\n' "$path" >&2
    exit 1
  fi

  test_path="$path/.__portageforge_write_test__"
  if id -u portage >/dev/null 2>&1; then
    printf -v test_path_q '%q' "$test_path"
    if ! su -s /bin/sh portage -c ": >$test_path_q && rm -f $test_path_q"; then
      printf '[portageforge] error: the portage user cannot write to %s\n' "$path" >&2
      exit 1
    fi
  else
    if ! touch "$test_path" || ! rm -f "$test_path"; then
      printf '[portageforge] error: cannot write to %s\n' "$path" >&2
      exit 1
    fi
  fi
}

prepare_target_workdirs() {
  local target_data_dir

  printf '[portageforge] preparing writable Portage work directories\n'
  mkdir -p "$(dirname "$TARGET_SYSROOT_PATH")" "$(dirname "$BROOT_PATH")"
  prepare_portage_traversable_dir "$DATA_ROOT"
  prepare_portage_traversable_dir "$TARGET_DATA_ROOT"
  target_data_dir=$(dirname "$PKGDIR_PATH")
  prepare_portage_writable_dir "$target_data_dir"
  prepare_portage_writable_dir "$PKGDIR_PATH"
  prepare_portage_writable_dir "$DISTDIR_PATH"
  rm -rf "$PORTAGE_TMPDIR_PATH"
  prepare_portage_writable_dir "$PORTAGE_TMPDIR_PATH"
}

broot_known_mount_paths() {
  [[ -n "$BROOT_PATH" ]] || return 0

  printf '%s\n' \
    "$BROOT_PATH/proc" \
    "$BROOT_PATH/sys" \
    "$BROOT_PATH/dev" \
    "$BROOT_PATH/run" \
    "$BROOT_PATH/mnt/portageforge-data" \
    "$BROOT_PATH/mnt/portageforge-targets" \
    "$BROOT_PATH/var/db/repos" \
    "$BROOT_PATH/var/lib/portageforge/targets" \
    "$BROOT_PATH/var/tmp/portageforge/targets"
}

unmount_broot_mount_list() {
  local -a mount_points=("$@")
  local i
  local mount_point
  local result=0

  for ((i = ${#mount_points[@]} - 1; i >= 0; i--)); do
    mount_point=${mount_points[$i]}
    if mountpoint -q "$mount_point"; then
      if ! umount -R "$mount_point"; then
        printf '[portageforge] error: could not unmount BROOT mount %s\n' "$mount_point" >&2
        result=1
      fi
    fi
  done

  return "$result"
}

unmount_broot_filesystems() {
  local result=0

  if ! unmount_broot_mount_list "${BROOT_MOUNT_POINTS[@]}"; then
    result=1
  fi
  BROOT_MOUNT_POINTS=()
  return "$result"
}

unmount_stale_broot_mounts() {
  local -a mount_points=()

  mapfile -t mount_points < <(broot_known_mount_paths)
  unmount_broot_mount_list "${mount_points[@]}"
}

mount_broot_proc() {
  local destination="$BROOT_PATH/proc"

  mkdir -p "$destination"
  if mountpoint -q "$destination"; then
    return 0
  fi
  if ! mount -t proc proc "$destination"; then
    printf '[portageforge] error: could not mount proc in isolated BROOT\n' >&2
    return 1
  fi
  BROOT_MOUNT_POINTS+=("$destination")
}

mount_broot_bind() {
  local destination=$2
  local mode=$3
  local source=$1

  mkdir -p "$destination"
  if mountpoint -q "$destination"; then
    return 0
  fi
  case "$mode" in
    bind)
      if ! mount --bind "$source" "$destination"; then
        printf '[portageforge] error: could not bind mount %s at %s\n' "$source" "$destination" >&2
        return 1
      fi
      ;;
    rbind)
      if ! mount --rbind "$source" "$destination"; then
        printf '[portageforge] error: could not recursive-bind mount %s at %s\n' "$source" "$destination" >&2
        return 1
      fi
      mount --make-rslave "$destination" || true
      ;;
    *)
      printf '[portageforge] error: unsupported BROOT mount mode: %s\n' "$mode" >&2
      return 1
      ;;
  esac
  BROOT_MOUNT_POINTS+=("$destination")
}

mount_broot_filesystems() {
  BROOT_MOUNT_POINTS=()
  printf '[portageforge] mounting isolated BROOT runtime filesystems\n'

  mkdir -p \
    "$BROOT_PATH/dev" \
    "$BROOT_PATH/mnt/portageforge-data" \
    "$BROOT_PATH/mnt/portageforge-targets" \
    "$BROOT_PATH/run" \
    "$BROOT_PATH/sys" \
    "$BROOT_PATH/var/db/repos" \
    "$BROOT_PATH/var/lib/portageforge/targets" \
    "$BROOT_PATH/var/tmp/portageforge/targets"

  mount_broot_proc || return 1
  mount_broot_bind /sys "$BROOT_PATH/sys" rbind || return 1
  mount_broot_bind /dev "$BROOT_PATH/dev" rbind || return 1
  mount_broot_bind /run "$BROOT_PATH/run" bind || return 1
  mount_broot_bind "$DATA_ROOT" "$BROOT_PATH$DATA_ROOT" bind || return 1
  mount_broot_bind "$TARGETS_MOUNT" "$BROOT_PATH$TARGETS_MOUNT" bind || return 1
  mount_broot_bind /var/db/repos "$BROOT_PATH/var/db/repos" bind || return 1
  mount_broot_bind "$TARGET_STATE_ROOT" "$BROOT_PATH$TARGET_STATE_ROOT" bind || return 1
  mount_broot_bind "$PORTAGE_TMPDIR_ROOT" "$BROOT_PATH$PORTAGE_TMPDIR_ROOT" bind || return 1
}

builder_run() {
  local command_name=$1
  shift

  env \
    ROOT=/ \
    SYSROOT=/ \
    BROOT=/ \
    PORTAGE_CONFIGROOT=/ \
    COMMON_FLAGS="$BUILDER_COMMON_FLAGS" \
    CFLAGS="$BUILDER_COMMON_FLAGS" \
    CXXFLAGS="$BUILDER_COMMON_FLAGS" \
    FCFLAGS="$BUILDER_COMMON_FLAGS" \
    FFLAGS="$BUILDER_COMMON_FLAGS" \
    MAKEOPTS="-j$BUILD_JOBS" \
    "$command_name" "$@"
}

builder_emerge() {
  builder_run emerge "$@"
}

validate_builder_runtime() {
  local required_command

  if ! command -v emerge >/dev/null 2>&1; then
    printf '[portageforge] error: emerge not found in builder root\n' >&2
    exit 1
  fi

  for required_command in gcc g++ make ar as ld pkg-config portageq sha256sum; do
    if ! command -v "$required_command" >/dev/null 2>&1; then
      printf '[portageforge] error: builder command is missing: %s\n' "$required_command" >&2
      exit 1
    fi
  done
}

update_builder_native_system() {
  printf '[portageforge] updating builder runtime packages\n'
  builder_emerge \
    --getbinpkg=n \
    --usepkg=n \
    --buildpkg=n \
    --update \
    --deep \
    --newuse \
    --jobs="$BUILD_JOBS" \
    @world
}

prepare_builder_native_system() {
  printf '[portageforge] syncing builder repository\n'
  run_with_sync_retries "builder repository sync" builder_emerge --sync
  validate_builder_runtime
  update_builder_native_system
  validate_builder_runtime

  printf '[portageforge] builder runtime package preparation complete\n'
}

sanitize_target_name() {
  local name=$1

  name=$(printf '%s' "$name" | tr -c 'A-Za-z0-9._-' '-')
  name=${name##-}
  name=${name%%-}
  printf '%s' "${name:-target}"
}

fetch_url() {
  local destination=$1
  local url=$2

  if command -v curl >/dev/null 2>&1; then
    curl -fL -o "$destination" "$url"
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$destination" "$url"
  else
    printf '[portageforge] error: curl or wget is required to fetch %s\n' "$url" >&2
    return 1
  fi
}

run_with_sync_retries() {
  local attempt
  local label=$1
  shift

  for ((attempt = 1; attempt <= SYNC_ATTEMPTS; attempt++)); do
    if "$@"; then
      return 0
    fi
    if [[ "$attempt" -eq "$SYNC_ATTEMPTS" ]]; then
      break
    fi
    printf '[portageforge] warning: %s failed on attempt %s/%s; retrying in %ss\n' "$label" "$attempt" "$SYNC_ATTEMPTS" "$SYNC_RETRY_SECONDS" >&2
    if [[ "$SYNC_RETRY_SECONDS" -gt 0 ]]; then
      sleep "$SYNC_RETRY_SECONDS"
    fi
  done

  printf '[portageforge] error: %s failed after %s attempt(s)\n' "$label" "$SYNC_ATTEMPTS" >&2
  return 1
}

stage3_variant_for_profile() {
  local init_style=openrc
  local profile=$1
  local variant=amd64

  if [[ "$profile" == *systemd* ]]; then
    init_style=systemd
  fi
  if [[ "$profile" == *no-multilib* || "$profile" == *nomultilib* ]]; then
    variant=amd64-nomultilib
  fi

  printf '%s-%s\n' "$variant" "$init_style"
}

download_stage3() {
  local actual_hash
  local archive_path
  local expected_hash
  local latest_file
  local sha_file
  local stage3_dir
  local stage3_name
  local variant=$1
  local variant_dir

  variant_dir=$(mktemp -d "$STAGE3_TMPDIR/$variant.XXXXXX")
  stage3_dir="current-stage3-$variant"
  latest_file="$variant_dir/latest-stage3-$variant.txt"

  if ! fetch_url "$latest_file" "$GENTOO_AUTOBUILDS_URL/$stage3_dir/latest-stage3-$variant.txt" >&2; then
    rm -rf "$variant_dir"
    return 1
  fi
  stage3_name=$(awk '/^[^#].*\.tar\.(xz|zst)[[:space:]]+[0-9]+/ { print $1; exit }' "$latest_file")
  if [[ -z "$stage3_name" ]]; then
    printf '[portageforge] error: could not find stage3 filename in %s\n' "$latest_file" >&2
    rm -rf "$variant_dir"
    return 1
  fi

  archive_path="$variant_dir/$stage3_name"
  sha_file="$archive_path.sha256"
  printf '[portageforge] fetching stage3 %s\n' "$stage3_name" >&2
  if ! fetch_url "$archive_path" "$GENTOO_AUTOBUILDS_URL/$stage3_dir/$stage3_name" >&2; then
    rm -rf "$variant_dir"
    return 1
  fi
  if ! fetch_url "$sha_file" "$GENTOO_AUTOBUILDS_URL/$stage3_dir/$stage3_name.sha256" >&2; then
    rm -rf "$variant_dir"
    return 1
  fi

  expected_hash=$(awk -v file="$stage3_name" '
    $0 ~ file {
      for (i = 1; i <= NF; i++) {
        if ($i ~ /^[0-9a-fA-F]{64}$/) {
          print tolower($i)
          exit
        }
      }
    }
  ' "$sha_file")
  if [[ -z "$expected_hash" ]]; then
    printf '[portageforge] error: could not parse SHA256 from %s\n' "$sha_file" >&2
    rm -rf "$variant_dir"
    return 1
  fi
  actual_hash=$(sha256sum "$archive_path" | awk '{ print $1 }')
  if [[ "$actual_hash" != "$expected_hash" ]]; then
    printf '[portageforge] error: SHA256 mismatch for %s\n' "$stage3_name" >&2
    rm -rf "$variant_dir"
    return 1
  fi

  printf '%s\n' "$archive_path"
}

extract_stage3_root() {
  local archive_path=$1
  local destination=$2

  mkdir -p "$destination"
  tar -xpf "$archive_path" -C "$destination" --xattrs --numeric-owner
}

prepare_target_roots() {
  local archive_path
  local profile=$1
  local stage3_download_dir
  local variant

  variant=$(stage3_variant_for_profile "$profile")
  archive_path=$(download_stage3 "$variant")
  stage3_download_dir=$(dirname "$archive_path")

  printf '[portageforge] recreating fresh %s target sysroot for %s\n' "$variant" "$TARGET_NAME"
  rm -rf "$TARGET_SYSROOT_PATH"
  mkdir -p "$TARGET_SYSROOT_PATH"
  if ! extract_stage3_root "$archive_path" "$TARGET_SYSROOT_PATH"; then
    rm -rf "$stage3_download_dir"
    return 1
  fi
  printf '%s\n' "$variant" >"$TARGET_SYSROOT_PATH/.portageforge-stage3-variant"

  printf '[portageforge] recreating fresh %s isolated native BROOT for %s\n' "$variant" "$TARGET_NAME"
  if ! unmount_stale_broot_mounts; then
    rm -rf "$stage3_download_dir"
    return 1
  fi
  rm -rf "$BROOT_PATH"
  mkdir -p "$BROOT_PATH"
  if ! extract_stage3_root "$archive_path" "$BROOT_PATH"; then
    rm -rf "$stage3_download_dir"
    return 1
  fi
  printf '%s\n' "$variant" >"$BROOT_PATH/.portageforge-stage3-variant"

  rm -rf "$stage3_download_dir"
}

metadata_value() {
  local name=$1
  local path="$TARGET_ROOT/metadata/$name"

  if [[ -s "$path" ]]; then
    awk 'NF { print; exit }' "$path"
  fi
  return 0
}

validate_snapshot_archive() {
  local archive=$1
  local bad_member

  if ! tar -tf "$archive" >/dev/null; then
    printf '[portageforge] error: target snapshot is not a readable tar archive: %s\n' "$archive" >&2
    exit 1
  fi

  bad_member=$(tar -tf "$archive" | awk '
    substr($0, 1, 1) == "/" || $0 == ".." || $0 ~ /^\.\.\// || $0 ~ /\/\.\.(\/|$)/ {
      print
      exit
    }
  ')
  if [[ -n "$bad_member" ]]; then
    printf '[portageforge] error: target snapshot contains unsafe tar member: %s\n' "$bad_member" >&2
    exit 1
  fi
}

validate_profile_name() {
  local profile=$1

  if [[ -z "$profile" || "$profile" == /* || "$profile" == .. || "$profile" == ../* || "$profile" == */../* || "$profile" == */.. ]]; then
    printf '[portageforge] error: target snapshot has an unsafe profile path: %s\n' "$profile" >&2
    exit 1
  fi
  if [[ ! "$profile" =~ ^[A-Za-z0-9._+/-]+$ ]]; then
    printf '[portageforge] error: target snapshot has unsupported profile characters: %s\n' "$profile" >&2
    exit 1
  fi
}

load_target_package_set() {
  local package_list=$1

  mkdir -p "$TARGET_SYSROOT_PATH/etc/portage/sets"
  awk 'NF && $1 !~ /^#/ { print $1 }' "$package_list" | sort -u >"$TARGET_SYSROOT_PATH$TARGET_PACKAGE_SET"
}

builder_make_conf_settings() {
  printf '\n# BEGIN portageforge-cross-builder\n'
  printf 'CBUILD="%s"\n' "$BUILDER_CHOST"
  printf 'CHOST="%s"\n' "$TARGET_CHOST"
  printf 'FEATURES="${FEATURES} buildpkg binpkg-multi-instance -test"\n'
  printf 'PKGDIR="%s"\n' "$PKGDIR_PATH"
  printf 'DISTDIR="%s"\n' "$DISTDIR_PATH"
  printf 'PORTAGE_TMPDIR="%s"\n' "$PORTAGE_TMPDIR_PATH"
  printf 'BINPKG_FORMAT="gpkg"\n'
  printf 'MAKEOPTS="-j%s"\n' "$BUILD_JOBS"
  printf '# END portageforge-cross-builder\n'
}

write_target_make_conf() {
  {
    cat "$TARGET_ROOT/etc/portage/make.conf"
    builder_make_conf_settings
  } >"$TARGET_SYSROOT_PATH/etc/portage/make.conf"
}

set_target_profile_link() {
  local profile=$1
  local profile_path="/var/db/repos/gentoo/profiles/$profile"

  if [[ ! -d "$profile_path" ]]; then
    printf '[portageforge] error: target profile not found after repository sync: %s\n' "$profile_path" >&2
    return 1
  fi

  printf '[portageforge] selecting target profile: %s\n' "$profile"
  rm -rf "$TARGET_SYSROOT_PATH/etc/portage/make.profile"
  ln -s "$profile_path" "$TARGET_SYSROOT_PATH/etc/portage/make.profile"
}

set_broot_profile_link() {
  local profile=$1
  local profile_path="/var/db/repos/gentoo/profiles/$profile"

  if [[ ! -d "$profile_path" ]]; then
    printf '[portageforge] error: BROOT profile not found after repository sync: %s\n' "$profile_path" >&2
    return 1
  fi

  printf '[portageforge] selecting isolated BROOT profile: %s\n' "$profile"
  rm -rf "$BROOT_PATH/etc/portage/make.profile"
  ln -s "$profile_path" "$BROOT_PATH/etc/portage/make.profile"
}

target_config_portage_envvar() {
  local variable_name=$1

  env \
    PORTAGE_CONFIGROOT="$TARGET_SYSROOT_PATH" \
    ROOT="$TARGET_SYSROOT_PATH" \
    SYSROOT="$TARGET_SYSROOT_PATH" \
    BROOT=/ \
    portageq envvar "$variable_name"
}

write_make_conf_assignment() {
  local variable_name=$1
  local value=$2

  [[ -n "$value" ]] || return 0
  if [[ "$value" == *$'\n'* || "$value" == *$'\r'* ]]; then
    printf '[portageforge] error: make.conf variable contains a newline and cannot be written safely: %s\n' "$variable_name" >&2
    return 1
  fi
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//\$/\\\$}
  value=${value//\`/\\\`}
  printf '%s="%s"\n' "$variable_name" "$value"
}

write_broot_make_conf() {
  local loaded=()
  local policy_variable
  local use_expand
  local value
  local variable_name

  {
    printf '# Generated by PortageForge for isolated native BROOT dependencies.\n'
    write_make_conf_assignment CBUILD "$BUILDER_CHOST"
    write_make_conf_assignment CHOST "$BUILDER_CHOST"
    write_make_conf_assignment ACCEPT_CHOSTS "$BUILDER_CHOST $TARGET_CHOST"
    write_make_conf_assignment COMMON_FLAGS "$BUILDER_COMMON_FLAGS"
    printf 'CFLAGS="${COMMON_FLAGS}"\n'
    printf 'CXXFLAGS="${COMMON_FLAGS}"\n'
    printf 'FCFLAGS="${COMMON_FLAGS}"\n'
    printf 'FFLAGS="${COMMON_FLAGS}"\n'
    printf 'FEATURES="${FEATURES} -buildpkg -test"\n'
    write_make_conf_assignment DISTDIR "$DISTDIR_PATH"
    write_make_conf_assignment PORTAGE_TMPDIR "$BROOT_PORTAGE_TMPDIR"
    write_make_conf_assignment MAKEOPTS "-j$BUILD_JOBS"

    for policy_variable in ACCEPT_KEYWORDS ACCEPT_LICENSE ACCEPT_PROPERTIES ACCEPT_RESTRICT GENTOO_MIRRORS USE; do
      if ! value=$(read_target_make_conf_value "$policy_variable"); then
        return 1
      fi
      if [[ -n "$value" ]]; then
        write_make_conf_assignment "$policy_variable" "$value"
        loaded+=("$policy_variable")
      fi
    done

    if ! use_expand=$(target_config_portage_envvar USE_EXPAND); then
      printf '[portageforge] error: could not read target USE_EXPAND\n' >&2
      return 1
    fi
    for variable_name in $use_expand; do
      is_broot_use_expand_variable_name "$variable_name" || continue
      if ! value=$(read_target_make_conf_value "$variable_name"); then
        return 1
      fi
      [[ -n "$value" ]] || continue
      write_make_conf_assignment "$variable_name" "$value"
      loaded+=("$variable_name")
    done
  } >"$BROOT_PATH/etc/portage/make.conf"

  if [[ "${#loaded[@]}" -gt 0 ]]; then
    printf '[portageforge] copied target feature policy into isolated BROOT make.conf: %s\n' "${loaded[*]}"
  fi
}

apply_broot_portage_config() {
  printf '[portageforge] applying target feature policy to isolated native BROOT\n'
  rm -rf "$BROOT_PATH/etc/portage"
  mkdir -p "$BROOT_PATH/etc"
  cp -a "$TARGET_ROOT/etc/portage" "$BROOT_PATH/etc/portage"
  rm -rf \
    "$BROOT_PATH/etc/portage/env" \
    "$BROOT_PATH/etc/portage/make.profile" \
    "$BROOT_PATH/etc/portage/package.env"
  rm -f "$BROOT_PATH$TARGET_PACKAGE_SET"
  if ! write_broot_make_conf; then
    return 1
  fi

  mkdir -p "$BROOT_PATH$BROOT_PORTAGE_TMPDIR"
  prepare_portage_writable_dir "$BROOT_PATH$BROOT_PORTAGE_TMPDIR"

  if [[ -f /etc/resolv.conf ]]; then
    cp -L /etc/resolv.conf "$BROOT_PATH/etc/resolv.conf"
  fi

  copy_broot_locale_state
}

copy_snapshot_path() {
  local destination
  local relative_path=$1
  local source

  source="$TARGET_ROOT/$relative_path"
  destination="$TARGET_SYSROOT_PATH/$relative_path"
  if [[ -e "$source" || -L "$source" ]]; then
    printf '[portageforge] copying target %s\n' "$relative_path"
    mkdir -p "$(dirname "$destination")"
    rm -rf "$destination"
    cp -a "$source" "$destination"
  fi
}

copy_broot_locale_state() {
  local destination
  local relative_path
  local source

  for relative_path in etc/locale.conf etc/locale.gen; do
    source="$TARGET_ROOT/$relative_path"
    destination="$BROOT_PATH/$relative_path"
    if [[ -e "$source" || -L "$source" ]]; then
      printf '[portageforge] copying target %s to isolated BROOT\n' "$relative_path"
      mkdir -p "$(dirname "$destination")"
      rm -rf "$destination"
      cp -a "$source" "$destination"
    fi
  done

}

copy_target_environment_state() {
  local snapshot_path

  for snapshot_path in \
    etc/env.d \
    etc/eselect \
    etc/python-exec \
    etc/java-config-2 \
    etc/locale.conf \
    etc/locale.gen \
    usr/src/linux; do
    copy_snapshot_path "$snapshot_path"
  done
}

validate_no_native_flags() {
  local failed=0
  local path

  for path in "$TARGET_SYSROOT_PATH/etc/portage/make.conf" "$TARGET_SYSROOT_PATH/etc/portage/env"; do
    [[ -e "$path" ]] || continue
    if grep -R -n -E -- '(^|[[:space:]])-m(arch|tune)=native([[:space:]]|$)' "$path" >&2; then
      failed=1
    fi
  done

  if [[ "$failed" -ne 0 ]]; then
    printf '[portageforge] error: true-cross builds require explicit target CPU flags, not -march=native or -mtune=native\n' >&2
    return 1
  fi
}

validate_microarchitecture_only_target() {
  local builder_suffix
  local native_chost
  local target_suffix

  native_chost=$(gcc -dumpmachine 2>/dev/null || true)
  if [[ -z "$native_chost" ]]; then
    printf '[portageforge] error: gcc -dumpmachine did not return the builder compiler target\n' >&2
    exit 1
  fi
  if ! is_safe_tuple "$native_chost"; then
    printf '[portageforge] error: builder gcc returned an unsupported target tuple: %s\n' "$native_chost" >&2
    exit 1
  fi

  if [[ "$TARGET_CHOST" != "$native_chost" ]]; then
    printf '[portageforge] error: this builder only supports microarchitecture-only cross builds\n' >&2
    printf '[portageforge] error: target CHOST from snapshot: %s\n' "$TARGET_CHOST" >&2
    printf '[portageforge] error: builder gcc -dumpmachine: %s\n' "$native_chost" >&2
    printf '[portageforge] error: use a real cross toolchain for arch, ABI, libc, or OS tuple changes\n' >&2
    exit 1
  fi

  if [[ "$BUILDER_CHOST" == "$native_chost" ]]; then
    printf '[portageforge] error: PORTAGEFORGE_BUILDER_CHOST must differ from %s to force cross-build behavior\n' "$native_chost" >&2
    exit 1
  fi

  builder_suffix=$(triplet_abi_suffix "$BUILDER_CHOST")
  target_suffix=$(triplet_abi_suffix "$TARGET_CHOST")
  if [[ "$(triplet_cpu "$BUILDER_CHOST")" != "$(triplet_cpu "$TARGET_CHOST")" || "$builder_suffix" != "$target_suffix" ]]; then
    printf '[portageforge] error: PORTAGEFORGE_BUILDER_CHOST may only change the vendor/name field\n' >&2
    printf '[portageforge] error: builder CBUILD: %s\n' "$BUILDER_CHOST" >&2
    printf '[portageforge] error: target CHOST: %s\n' "$TARGET_CHOST" >&2
    exit 1
  fi
}

apply_target_portage_config() {
  printf '[portageforge] applying target /etc/portage snapshot to sysroot\n'
  printf '[portageforge] copying target Portage config tree\n'
  rm -rf "$TARGET_SYSROOT_PATH/etc/portage"
  mkdir -p "$TARGET_SYSROOT_PATH/etc"
  cp -a "$TARGET_ROOT/etc/portage" "$TARGET_SYSROOT_PATH/etc/portage"
  rm -rf "$TARGET_SYSROOT_PATH/etc/portage/make.profile"
  printf '[portageforge] writing target package set\n'
  rm -f "$TARGET_SYSROOT_PATH$TARGET_PACKAGE_SET"
  load_target_package_set "$TARGET_PACKAGE_LIST"
  if [[ ! -s "$TARGET_SYSROOT_PATH$TARGET_PACKAGE_SET" ]]; then
    printf '[portageforge] error: target package list has no package entries: %s\n' "$TARGET_PACKAGE_LIST" >&2
    exit 1
  fi
  printf '[portageforge] writing target make.conf\n'
  write_target_make_conf
  printf '[portageforge] copying target runtime environment state\n'
  copy_target_environment_state
  printf '[portageforge] validating target Portage flags\n'
  validate_no_native_flags
  printf '[portageforge] target Portage snapshot applied\n'
}

broot_host_path() {
  local path=$1

  printf '%s%s\n' "$BROOT_PATH" "$path"
}

broot_command_path() {
  local command_name=$1
  local prefix

  for prefix in /usr/local/bin /usr/bin /bin /usr/local/sbin /usr/sbin /sbin; do
    if [[ -x "$BROOT_PATH$prefix/$command_name" ]]; then
      printf '%s/%s\n' "$prefix" "$command_name"
      return 0
    fi
  done
  return 1
}

write_compiler_wrapper() {
  local native_command=$1
  local wrapper_flags=$3
  local wrapper_path=$2

  {
    printf '#!/usr/bin/env bash\n'
    printf 'set -e\n'
    printf 'PORTAGEFORGE_WRAPPER_FLAGS=%q\n' "$wrapper_flags"
    printf '# shellcheck disable=SC2086\n'
    printf 'set -- "$@" $PORTAGEFORGE_WRAPPER_FLAGS\n'
    printf 'exec %q "$@"\n' "$native_command"
  } >"$wrapper_path"
  chmod 755 "$wrapper_path"
}

write_passthrough_wrapper() {
  local native_command=$1
  local wrapper_path=$2

  {
    printf '#!/usr/bin/env bash\n'
    printf 'set -e\n'
    printf 'exec %q "$@"\n' "$native_command"
  } >"$wrapper_path"
  chmod 755 "$wrapper_path"
}

write_target_compiler_wrapper() {
  local native_command=$1
  local wrapper_path=$2

  {
    printf '#!/usr/bin/env bash\n'
    printf 'set -e\n'
    printf 'exec %q --sysroot=%q -B%q "$@"\n' "$native_command" "$TARGET_SYSROOT_PATH" "$TARGET_WRAPPERS_DIR/$TARGET_CHOST-"
  } >"$wrapper_path"
  chmod 755 "$wrapper_path"
}

write_target_binutils_wrapper() {
  local native_command=$1
  local tool_name=$3
  local wrapper_path=$2

  {
    printf '#!/usr/bin/env bash\n'
    printf 'set -e\n'
    case "$tool_name" in
      ld|ld.bfd|ld.gold|ld.lld)
        printf 'exec %q --sysroot=%q "$@"\n' "$native_command" "$TARGET_SYSROOT_PATH"
        ;;
      *)
        printf 'exec %q "$@"\n' "$native_command"
        ;;
    esac
  } >"$wrapper_path"
  chmod 755 "$wrapper_path"
}

write_target_pkg_config_wrapper() {
  local native_command=$1
  local wrapper_path=$2

  {
    printf '#!/usr/bin/env bash\n'
    printf 'set -e\n'
    printf 'export PKG_CONFIG_SYSROOT_DIR=%q\n' "$TARGET_SYSROOT_PATH"
    printf 'export PKG_CONFIG_LIBDIR=%q\n' "$TARGET_SYSROOT_PATH/usr/lib64/pkgconfig:$TARGET_SYSROOT_PATH/usr/lib/pkgconfig:$TARGET_SYSROOT_PATH/usr/share/pkgconfig"
    printf 'exec %q "$@"\n' "$native_command"
  } >"$wrapper_path"
  chmod 755 "$wrapper_path"
}

create_builder_wrappers() {
  local native
  local spec
  local tool
  local wrapper_dir

  wrapper_dir=$(broot_host_path "$BUILD_WRAPPERS_DIR")
  mkdir -p "$wrapper_dir"
  find "$wrapper_dir" -maxdepth 1 -type f -name "$BUILDER_CHOST-*" -exec rm -f -- {} +
  for spec in \
    gcc:gcc g++:g++ cc:gcc c++:g++ cpp:cpp \
    ar:ar as:as ld:ld nm:nm ranlib:ranlib strip:strip \
    objcopy:objcopy objdump:objdump readelf:readelf pkg-config:pkg-config; do
    tool=${spec%%:*}
    native=$(broot_command_path "${spec#*:}" || true)
    if [[ "$tool" == pkg-config && -z "$native" ]]; then
      native=/usr/bin/pkg-config
    fi
    [[ -n "$native" ]] || continue
    case "$tool" in
      gcc|g++|cc|c++|cpp)
        write_compiler_wrapper "$native" "$wrapper_dir/$BUILDER_CHOST-$tool" "$BUILDER_COMMON_FLAGS"
        ;;
      *)
        write_passthrough_wrapper "$native" "$wrapper_dir/$BUILDER_CHOST-$tool"
        ;;
    esac
  done
}

create_target_wrappers() {
  local native
  local spec
  local tool

  TARGET_WRAPPERS_DIR="$PORTAGE_TMPDIR_PATH/target-wrappers"
  rm -rf "$TARGET_WRAPPERS_DIR"
  mkdir -p "$TARGET_WRAPPERS_DIR"

  for spec in gcc:gcc g++:g++ cc:gcc c++:g++ cpp:cpp; do
    tool=${spec%%:*}
    native=$(broot_command_path "${spec#*:}" || true)
    if [[ -z "$native" ]]; then
      printf '[portageforge] error: required compiler command not found: %s\n' "${spec#*:}" >&2
      exit 1
    fi
    write_target_compiler_wrapper "$native" "$TARGET_WRAPPERS_DIR/$TARGET_CHOST-$tool"
  done

  for spec in ar:ar as:as ld:ld ld.bfd:ld.bfd ld.gold:ld.gold ld.lld:ld.lld nm:nm ranlib:ranlib strip:strip objcopy:objcopy objdump:objdump readelf:readelf; do
    tool=${spec%%:*}
    native=$(broot_command_path "${spec#*:}" || true)
    [[ -n "$native" ]] || continue
    write_target_binutils_wrapper "$native" "$TARGET_WRAPPERS_DIR/$TARGET_CHOST-$tool" "$tool"
  done

  native=$(broot_command_path pkg-config || true)
  native=${native:-/usr/bin/pkg-config}
  write_target_pkg_config_wrapper "$native" "$TARGET_WRAPPERS_DIR/$TARGET_CHOST-pkg-config"
}

target_portage_envvar() {
  local variable_name=$1

  if ! cross_run portageq envvar "$variable_name"; then
    printf '[portageforge] error: could not read target Portage variable: %s\n' "$variable_name" >&2
    return 1
  fi
}

read_target_make_conf_value() {
  local value
  local variable_name=$1

  if ! value=$(python3 -c 'import portage.util, sys; v = (portage.util.getconfig(sys.argv[1], expand=True) or {}).get(sys.argv[2], ""); sys.exit(2) if "\n" in v or "\r" in v else print(v)' "$TARGET_ROOT/etc/portage/make.conf" "$variable_name"); then
    printf '[portageforge] error: could not read target make.conf variable: %s\n' "$variable_name" >&2
    return 1
  fi
  printf '%s\n' "$value"
}

is_broot_use_expand_variable_name() {
  local variable_name=$1

  case "$variable_name" in
    ""|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_]*)
      return 1
      ;;
    ABI_*|CPU_FLAGS_*|ELIBC|KERNEL|USERLAND)
      return 1
      ;;
    *)
      return 0
      ;;
  esac
}

validate_tool_wrappers() {
  local build_wrappers_host_dir
  local probe_dir="$PORTAGE_TMPDIR_PATH/wrapper-probe"
  local target_cflags
  local target_cxxflags
  local wrapper_path

  printf '[portageforge] validating builder and target wrapper toolchains\n'
  rm -rf "$probe_dir"
  mkdir -p "$probe_dir"

  build_wrappers_host_dir=$(broot_host_path "$BUILD_WRAPPERS_DIR")
  for wrapper_path in \
    "$build_wrappers_host_dir/$BUILDER_CHOST-gcc" \
    "$build_wrappers_host_dir/$BUILDER_CHOST-g++" \
    "$TARGET_WRAPPERS_DIR/$TARGET_CHOST-gcc" \
    "$TARGET_WRAPPERS_DIR/$TARGET_CHOST-g++" \
    "$TARGET_WRAPPERS_DIR/$TARGET_CHOST-pkg-config"; do
    if [[ ! -x "$wrapper_path" ]]; then
      printf '[portageforge] error: expected wrapper is missing or not executable: %s\n' "$wrapper_path" >&2
      return 1
    fi
  done

  printf 'int main(void) { return 0; }\n' >"$probe_dir/build.c"
  if ! broot_run "$BUILDER_CHOST-gcc" "$probe_dir/build.c" -o "$probe_dir/build-c"; then
    printf '[portageforge] error: builder C compiler wrapper failed\n' >&2
    return 1
  fi
  if ! broot_run "$probe_dir/build-c"; then
    printf '[portageforge] error: builder C compiler produced a non-runnable helper binary\n' >&2
    return 1
  fi

  printf 'int main() { return 0; }\n' >"$probe_dir/build.cc"
  if ! broot_run "$BUILDER_CHOST-g++" "$probe_dir/build.cc" -o "$probe_dir/build-cxx"; then
    printf '[portageforge] error: builder C++ compiler wrapper failed\n' >&2
    return 1
  fi
  if ! broot_run "$probe_dir/build-cxx"; then
    printf '[portageforge] error: builder C++ compiler produced a non-runnable helper binary\n' >&2
    return 1
  fi

  if ! target_cflags=$(target_portage_envvar CFLAGS); then
    return 1
  fi
  printf '#include <stdio.h>\nint portageforge_c_probe(void) { return EOF == EOF ? 0 : 1; }\n' >"$probe_dir/target.c"
  # shellcheck disable=SC2086
  if ! cross_run "$TARGET_CHOST-gcc" $target_cflags -c "$probe_dir/target.c" -o "$probe_dir/target.o"; then
    printf '[portageforge] error: target C compiler wrapper failed with target CFLAGS: %s\n' "$target_cflags" >&2
    return 1
  fi

  if ! target_cxxflags=$(target_portage_envvar CXXFLAGS); then
    return 1
  fi
  printf '#include <cstdio>\nint portageforge_cxx_probe() { return EOF == EOF ? 0 : 1; }\n' >"$probe_dir/target.cc"
  # shellcheck disable=SC2086
  if ! cross_run "$TARGET_CHOST-g++" $target_cxxflags -c "$probe_dir/target.cc" -o "$probe_dir/target-cxx.o"; then
    printf '[portageforge] error: target C++ compiler wrapper failed with target CXXFLAGS: %s\n' "$target_cxxflags" >&2
    return 1
  fi
}

broot_run() {
  local command_name=$1
  local env_args=(
    PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    HOME=/root
    ROOT=/
    SYSROOT=/
    BROOT=/
    PORTAGE_CONFIGROOT=/
    CBUILD="$BUILDER_CHOST"
    CHOST="$BUILDER_CHOST"
    COMMON_FLAGS="$BUILDER_COMMON_FLAGS"
    CFLAGS="$BUILDER_COMMON_FLAGS"
    CXXFLAGS="$BUILDER_COMMON_FLAGS"
    FCFLAGS="$BUILDER_COMMON_FLAGS"
    FFLAGS="$BUILDER_COMMON_FLAGS"
    MAKEOPTS="-j$BUILD_JOBS"
  )
  shift

  chroot "$BROOT_PATH" /usr/bin/env "${env_args[@]}" "$command_name" "$@"
}

generate_broot_locales() {
  if [[ ! -x "$BROOT_PATH/usr/sbin/locale-gen" && ! -x "$BROOT_PATH/usr/bin/locale-gen" ]]; then
    printf '[portageforge] warning: locale-gen not found in isolated BROOT\n' >&2
    return 0
  fi

  printf '[portageforge] generating locales in isolated BROOT\n'
  broot_run locale-gen
}

cross_run() {
  local build_tool_prefix="$BUILD_WRAPPERS_DIR/$BUILDER_CHOST"
  local command_name=$1
  local target_tool_prefix="$TARGET_WRAPPERS_DIR/$TARGET_CHOST"
  local env_args=(
    PATH="$TARGET_WRAPPERS_DIR:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    HOME=/root
    PORTAGE_CONFIGROOT="$TARGET_SYSROOT_PATH"
    ROOT="$TARGET_SYSROOT_PATH"
    SYSROOT="$TARGET_SYSROOT_PATH"
    BROOT=/
    CBUILD="$BUILDER_CHOST"
    CHOST="$TARGET_CHOST"
    BUILD_CC="$build_tool_prefix-gcc"
    BUILD_CXX="$build_tool_prefix-g++"
    BUILD_CPP="$build_tool_prefix-cpp"
    BUILD_AR="$build_tool_prefix-ar"
    BUILD_AS="$build_tool_prefix-as"
    BUILD_LD="$build_tool_prefix-ld"
    BUILD_NM="$build_tool_prefix-nm"
    BUILD_RANLIB="$build_tool_prefix-ranlib"
    BUILD_PKG_CONFIG="$build_tool_prefix-pkg-config"
    CC_FOR_BUILD="$build_tool_prefix-gcc"
    CXX_FOR_BUILD="$build_tool_prefix-g++"
    CPP_FOR_BUILD="$build_tool_prefix-cpp"
    AR_FOR_BUILD="$build_tool_prefix-ar"
    AS_FOR_BUILD="$build_tool_prefix-as"
    LD_FOR_BUILD="$build_tool_prefix-ld"
    NM_FOR_BUILD="$build_tool_prefix-nm"
    RANLIB_FOR_BUILD="$build_tool_prefix-ranlib"
    PKG_CONFIG_FOR_BUILD="$build_tool_prefix-pkg-config"
    HOSTCC="$build_tool_prefix-gcc"
    HOSTCXX="$build_tool_prefix-g++"
    HOST_CC="$build_tool_prefix-gcc"
    HOST_CXX="$build_tool_prefix-g++"
    CC="$target_tool_prefix-gcc"
    CXX="$target_tool_prefix-g++"
    CPP="$target_tool_prefix-cpp"
    AR="$target_tool_prefix-ar"
    AS="$target_tool_prefix-as"
    LD="$target_tool_prefix-ld"
    NM="$target_tool_prefix-nm"
    RANLIB="$target_tool_prefix-ranlib"
    STRIP="$target_tool_prefix-strip"
    PKG_CONFIG="$target_tool_prefix-pkg-config"
    CFLAGS_FOR_BUILD="$BUILDER_COMMON_FLAGS"
    CXXFLAGS_FOR_BUILD="$BUILDER_COMMON_FLAGS"
  )
  shift

  chroot "$BROOT_PATH" /usr/bin/env "${env_args[@]}" "$command_name" "$@"
}

cross_emerge() {
  cross_run emerge \
    --root="$TARGET_SYSROOT_PATH" \
    --sysroot="$TARGET_SYSROOT_PATH" \
    --config-root="$TARGET_SYSROOT_PATH" \
    "$@"
}

cross_emaint() {
  cross_run emaint "$@"
}

install_target_build_dependencies() {
  local emerge_args=(
    "${CROSS_RESOLVER_ARGS[@]}"
    --usepkg=n
    --getbinpkg=n
    --oneshot
    --ignore-world=y
    --onlydeps
    --emptytree
    --onlydeps-with-rdeps=n
    --onlydeps-with-ideps=n
    --with-bdeps=y
    --buildpkg=n
    --jobs="$BUILD_JOBS"
  )
  local targets=("$@")

  printf '[portageforge] installing target build dependencies with split BROOT/SYSROOT policy\n'
  cross_emerge "${emerge_args[@]}" "${targets[@]}"
}

emerge_target_packages() {
  local emerge_args=(
    "${CROSS_RESOLVER_ARGS[@]}"
    --usepkg=n
    --getbinpkg=n
    --oneshot
    --ignore-world=y
    --with-bdeps=n
    --buildpkg
    --emptytree
    --jobs="$BUILD_JOBS"
  )
  local targets=(@system @portageforge-binhost-packages)

  if ! install_target_build_dependencies "${targets[@]}"; then
    return 1
  fi

  printf '[portageforge] cross-building full target binhost package set\n'
  cross_emerge "${emerge_args[@]}" "${targets[@]}"
}

prepare_builder_from_snapshot() {
  local archive=$1
  local archive_name
  local hostname=
  local profile

  rm -rf "$TARGET_ROOT"
  mkdir -p "$TARGET_ROOT"

  printf '[portageforge] loading target snapshot %s\n' "$archive"
  validate_snapshot_archive "$archive"
  tar -C "$TARGET_ROOT" -xf "$archive"

  hostname=$(metadata_value hostname)
  if [[ -n "$hostname" ]]; then
    printf '[portageforge] target hostname: %s\n' "$hostname"
  fi
  archive_name=$(basename "$archive" .tar)
  if [[ -z "$hostname" ]]; then
    hostname=$archive_name
  fi

  profile=$(metadata_value profile)
  if [[ -z "$profile" ]]; then
    printf '[portageforge] error: target snapshot is missing metadata/profile\n' >&2
    exit 1
  fi
  validate_profile_name "$profile"
  TARGET_CHOST=$(metadata_value chost)
  if [[ -z "$TARGET_CHOST" ]]; then
    printf '[portageforge] error: target snapshot is missing metadata/chost\n' >&2
    printf '[portageforge] error: re-run make export-target-state on the target\n' >&2
    exit 1
  fi
  if [[ "$TARGET_CHOST" == "$BUILDER_CHOST" ]]; then
    printf '[portageforge] error: target CHOST and builder CBUILD must differ: %s\n' "$TARGET_CHOST" >&2
    exit 1
  fi
  if [[ ! "$TARGET_CHOST" =~ ^[A-Za-z0-9._-]+$ ]]; then
    printf '[portageforge] error: invalid target CHOST in snapshot: %s\n' "$TARGET_CHOST" >&2
    exit 1
  fi
  validate_microarchitecture_only_target

  TARGET_NAME=$(sanitize_target_name "$hostname")
  TARGET_PACKAGE_LIST="$TARGETS_MOUNT/${archive_name}.packages"
  TARGET_SYSROOT_PATH="$TARGET_STATE_ROOT/$TARGET_NAME/sysroot"
  BROOT_PATH="$BROOT_STATE_ROOT/$TARGET_NAME/root"
  PORTAGE_TMPDIR_PATH="$PORTAGE_TMPDIR_ROOT/$TARGET_NAME"
  PKGDIR_PATH="$TARGET_DATA_ROOT/$TARGET_NAME/binpkgs"
  DISTDIR_PATH="$TARGET_DATA_ROOT/$TARGET_NAME/distfiles"
  prepare_target_workdirs

  if [[ -d "$TARGET_PACKAGE_LIST" ]]; then
    printf '[portageforge] error: target package path must be a package-root file, not a directory: %s\n' "$TARGET_PACKAGE_LIST" >&2
    printf '[portageforge] error: re-run make export-target-state on the target to create a single %s file\n' "$TARGET_PACKAGE_LIST" >&2
    exit 1
  fi
  if [[ ! -s "$TARGET_PACKAGE_LIST" ]]; then
    printf '[portageforge] error: target package list not found or empty: %s\n' "$TARGET_PACKAGE_LIST" >&2
    exit 1
  fi
  if [[ ! -d "$TARGET_ROOT/etc/portage" ]]; then
    printf '[portageforge] error: target snapshot is missing etc/portage\n' >&2
    exit 1
  fi
  if [[ ! -s "$TARGET_ROOT/etc/portage/make.conf" ]]; then
    printf '[portageforge] error: target snapshot is missing etc/portage/make.conf\n' >&2
    exit 1
  fi

  prepare_target_roots "$profile" || return 1
  apply_target_portage_config || return 1
  set_target_profile_link "$profile" || return 1
  apply_broot_portage_config || return 1
  set_broot_profile_link "$profile" || return 1
  create_builder_wrappers || return 1
  create_target_wrappers || return 1

  printf '[portageforge] builder CBUILD: %s\n' "$BUILDER_CHOST"
  printf '[portageforge] isolated BROOT: %s\n' "$BROOT_PATH"
  printf '[portageforge] target CHOST: %s\n' "$TARGET_CHOST"
  printf '[portageforge] target sysroot: %s\n' "$TARGET_SYSROOT_PATH"
  printf '[portageforge] target Portage tmpdir: %s\n' "$PORTAGE_TMPDIR_PATH"
  printf '[portageforge] target binhost path: /targets/%s/binpkgs/\n' "$TARGET_NAME"
  printf '[portageforge] using %s build job(s)\n' "$BUILD_JOBS"
  printf '[portageforge] loaded %s binhost package entries\n' "$(wc -l <"$TARGET_SYSROOT_PATH$TARGET_PACKAGE_SET")"
}

start_binhost_server() {
  if [[ -n "$HTTP_PID" ]] && kill -0 "$HTTP_PID" 2>/dev/null; then
    return
  fi

  if ! command -v python3 >/dev/null 2>&1; then
    printf '[portageforge] error: python3 is required to serve the binhost\n' >&2
    exit 1
  fi

  mkdir -p "$TARGET_DATA_ROOT"
  python3 -m http.server "$BINHOST_PORT" --bind 0.0.0.0 --directory "$DATA_ROOT" &
  HTTP_PID=$!
  trap cleanup EXIT
  trap 'cleanup; exit 0' INT TERM
  sleep 1
  if ! kill -0 "$HTTP_PID" 2>/dev/null; then
    printf '[portageforge] error: binhost HTTP server failed to start\n' >&2
    exit 1
  fi
  printf '[portageforge] serving binhosts at http://0.0.0.0:%s/targets/<target>/binpkgs/\n' "$BINHOST_PORT"
}

build_target() {
  local archive=$1
  local result=0

  prepare_builder_from_snapshot "$archive" || return 1
  if ! mount_broot_filesystems; then
    printf '[portageforge] error: could not mount isolated BROOT for %s\n' "$TARGET_NAME" >&2
    unmount_broot_filesystems || true
    return 1
  fi

  if ! generate_broot_locales; then
    printf '[portageforge] error: locale generation failed in isolated BROOT for %s\n' "$TARGET_NAME" >&2
    result=1
  fi

  printf '[portageforge] syncing repositories for %s\n' "$TARGET_NAME"
  if [[ "$result" -eq 0 ]] && ! run_with_sync_retries "target repository sync for $TARGET_NAME" cross_emerge --sync; then
    printf '[portageforge] error: repository sync failed for %s\n' "$TARGET_NAME" >&2
    result=1
  fi

  if [[ "$result" -eq 0 ]] && ! set_target_profile_link "$(metadata_value profile)"; then
    result=1
  fi

  if [[ "$result" -eq 0 ]] && ! set_broot_profile_link "$(metadata_value profile)"; then
    result=1
  fi

  if [[ "$result" -eq 0 ]]; then
    if ! validate_tool_wrappers; then
      printf '[portageforge] error: wrapper validation failed for %s\n' "$TARGET_NAME" >&2
      result=1
    fi
  fi

  if [[ "$result" -eq 0 ]] && ! emerge_target_packages; then
    printf '[portageforge] error: target cross-build failed for %s\n' "$TARGET_NAME" >&2
    result=1
  fi

  if [[ "$result" -eq 0 ]]; then
    printf '[portageforge] refreshing binhost package index\n'
    if ! cross_emaint binhost --fix; then
      printf '[portageforge] error: binhost index refresh failed for %s\n' "$TARGET_NAME" >&2
      result=1
    fi
  fi

  if ! unmount_broot_filesystems; then
    result=1
  fi

  return "$result"
}

build_cycle() {
  local archive
  local archives=()
  local result=0

  mapfile -t archives < <(list_target_archives)
  if [[ "${#archives[@]}" -eq 0 ]]; then
    printf '[portageforge] error: no target snapshot tar found in %s\n' "$TARGETS_MOUNT" >&2
    exit 1
  fi
  printf '[portageforge] found %s target snapshot(s)\n' "${#archives[@]}"

  for archive in "${archives[@]}"; do
    printf '[portageforge] starting true-cross target snapshot %s\n' "$archive"
    if ! build_target "$archive"; then
      result=1
    fi
  done

  return "$result"
}

prepare_targets_share
prepare_data_share
load_builder_config
validate_builder_config
printf '[portageforge] starting true-cross microarchitecture-only builder\n'
prepare_builder_native_system
start_binhost_server
while true; do
  if build_cycle; then
    printf '[portageforge] build cycle completed successfully\n'
  else
    printf '[portageforge] build cycle completed with errors\n' >&2
  fi
  printf '[portageforge] sleeping %ss before next sync/build\n' "$BUILD_INTERVAL_SECONDS"
  sleep "$BUILD_INTERVAL_SECONDS"
done
